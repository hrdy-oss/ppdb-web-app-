# Salin menjadi .env (di luar document root) lalu isi nilainya. JANGAN commit .env ke GitHub.
DB_HOST=lks-db.xxxxxxxx.ap-southeast-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=ppdb
DB_USER=admin
DB_PASS=
S3_BUCKET=lks-ppdb-namapeserta
S3_REGION=ap-southeast-1
# Tanpa akses IAM: isi kredensial dari panitia / lab. Jika ada IAM Role pada instance, kosongkan ketiganya.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
